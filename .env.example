# Copy to `.env` on the server (next to docker-compose.yml). Never commit .env.
#
# The apex domain the platform serves. The homepage is served at this domain;
# projects live at <sub>.<DOMAIN> (e.g. roadtrip.<DOMAIN>).
DOMAIN=example.com

# Contact address Let's Encrypt uses for your account + cert-expiry notices.
ACME_EMAIL=you@example.com

# Edge passwords, one per private app (caddy/Caddyfile `import private`).
# Set them with deploy/set-edge-password.sh <app>, which hashes locally and
# writes both lines. Values MUST be single-quoted: Compose reads the `$`s in an
# unquoted or double-quoted bcrypt hash as variables and cuts it short (then no
# password matches). A missing pair locks that app (fail-closed), nothing else.
# EDGE_AUTH_FLIGHTS_USER='george'
# EDGE_AUTH_FLIGHTS_HASH='$2a$14$...'
# EDGE_AUTH_SPEED_USER / EDGE_AUTH_SPEED_HASH
# EDGE_AUTH_OKTOPUS_USER / EDGE_AUTH_OKTOPUS_HASH
# EDGE_AUTH_LIFTMAP_DASH_USER / EDGE_AUTH_LIFTMAP_DASH_HASH   (liftmap-api /_/)
