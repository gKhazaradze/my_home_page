# ─────────────────────────────────────────────────────────────────────────
# The entire edge routing table. Caddy auto-provisions Let's Encrypt certs
# per hostname (HTTP-01), so every site below gets HTTPS with no extra config.
#
# DOMAIN and ACME_EMAIL are read from the .env file (see docker-compose.yml),
# so this file is reusable and the domain is never hard-coded.
#
# Adding a project = paste the 3-line template block at the bottom, change the
# subdomain + container name, and `caddy reload`. The wildcard DNS A record
# means no DNS change is needed for a new subdomain.
# ─────────────────────────────────────────────────────────────────────────
{
	email {$ACME_EMAIL}
}

# ── Shared: Digital Asset Links ──────────────────────────────────────────────
# The Android app (a Trusted Web Activity — see android/) is only allowed to
# show a site full-screen, with no browser URL bar, if that site's ORIGIN serves
# /.well-known/assetlinks.json naming the app's package and signing fingerprint.
#
# Every project subdomain is a separate origin, so every one of them needs that
# file — but the projects live in their own repos and none of them should have
# to know the app exists. So the edge answers for them: this snippet serves the
# platform's single copy from /srv/site, and everything else still reaches the
# project container untouched.
#
# `handle` sorts before `reverse_proxy` in Caddy's directive order, so a request
# for any OTHER path falls straight through to the proxy below it — which is why
# each project block stays bare. Verified end to end: the upstream still sees the
# original path and Host, and bustracker's header block still applies to both.
#
# The apex needs no import — it already serves /srv/site with file_server, and
# Caddy's file_server does serve dot-directories.
(assetlinks) {
	handle /.well-known/assetlinks.json {
		root * /srv/site
		file_server
	}
}

# ── Shared: edge auth for PRIVATE apps ───────────────────────────────────────
# Any project meant for me only adds `import private` to its block; public
# projects simply don't. One credential guards them all — to rotate it, run
#   docker run --rm caddy:2-alpine caddy hash-password
# and replace the hash below. Browsers cache Basic credentials per subdomain,
# so each private app asks once per device, then never again.
#
# /.well-known/assetlinks.json is excluded on purpose: Chrome fetches it with
# NO credentials when the Android TWA verifies the origin, so putting it behind
# auth would silently break full-screen mode for every private app. basic_auth
# sorts BEFORE handle in Caddy's directive order, which is why the exclusion
# must live here as a matcher rather than relying on the assetlinks handle.
(private) {
	@needs_auth not path /.well-known/assetlinks.json
	basic_auth @needs_auth {
		george $2a$14$3Wm148JHMqkWnzoi6kF.L.DypoW9vm1mq0j6/uwqChpjIpo.6A7mW
	}
}

# ── Apex: the homepage hub, served straight off disk (no homepage container) ──
{$DOMAIN} {
	root * /srv/site
	file_server
	encode zstd gzip # homepage is static; safe to compress here
}

# www → apex (single canonical homepage)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# ── Project #1: roadtrip — reached by container name over the `web` network ──
# Keep this block BARE: roadtrip's Flask already gzips (Flask-Compress) and sets
# X-Content-Type-Options / X-Frame-Options / Referrer-Policy. Adding `encode` or
# headers here would double-compress and emit doubled headers. Caddy passes the
# app's responses straight through.
roadtrip.{$DOMAIN} {
	import assetlinks
	reverse_proxy roadtrip:8000
}

# ── Project #2: availability — personal availability calendar ────────────────
# Keep this block BARE: the Flask app already gzips (Flask-Compress) and sets
# X-Content-Type-Options / X-Frame-Options / Referrer-Policy (and no-store on
# /api/*). Adding `encode` or headers here would double them up.
availability.{$DOMAIN} {
	import assetlinks
	reverse_proxy availability:8000
}

# ── Project #3: bustracker — live Tbilisi bus map ────────────────────────────
# NOT bare, and NOT `encode` either. This one is a stdlib http.server, not Flask:
# server.py gzips its own responses (anything over 1 KB, with Content-Encoding +
# Vary), so adding `encode` here would double-compress — but it sets none of the
# security headers the Flask apps set, so those go on at the edge.
# It listens on 8765, not 8000.
bustracker.{$DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	import assetlinks
	reverse_proxy bustracker:8765
}

# ── Project #4: citywatch — public live camera feeds ─────────────────────────
# Keep this block BARE: the container is nginx serving a static Vite build, and
# its own config already gzips (gzip on, over 1 KB, with Vary) and sets
# Content-Security-Policy / X-Content-Type-Options / Referrer-Policy on every
# location. Adding `encode` or headers here would double them up.
#
# It sets no X-Frame-Options on purpose — its CSP carries `frame-ancestors
# 'self'`, which supersedes it. Don't "fix" that by adding the header here.
#
# It listens on 80 (nginx default), not 8000.
citywatch.{$DOMAIN} {
	import assetlinks
	reverse_proxy citywatch:80
}

# ── Project #5: flights — airport-pickup flight tracker ──────────────────────
# NOT bare, and NOT `encode` either. Like bustracker this is a stdlib
# http.server: server.py gzips its own responses (over 1 KB, with
# Content-Encoding + Vary), so adding `encode` here would double-compress —
# but it sets none of the security headers the Flask apps set, so those go on
# at the edge. It listens on 8766, not 8000.
#
# PRIVATE: personal app — `import private` puts the whole subdomain behind the
# shared edge basic_auth (assetlinks excluded inside the snippet).
flights.{$DOMAIN} {
	import private
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	import assetlinks
	reverse_proxy flights:8766
}

