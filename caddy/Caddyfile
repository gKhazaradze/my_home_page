# ── Project #8: liftmap-api — PocketBase backend for the LiftMap app ─────────
# Only the Dashboard (/_/) is behind basic_auth, with its own credential (same
# fail-closed default as the private snippet); /api/* and the public pages are
# open (the app talks to /api/ with a user token). The Dashboard's own API calls
# carry the superuser token, not this credential, so it is dropped only on /_/.
# Repo: gKhazaradze/liftmap-api.
liftmap-api.{$DOMAIN} {
	import hsts
	import assetlinks
	@dash path /_ /_/*
	basic_auth @dash {
		{$EDGE_AUTH_LIFTMAP_DASH_USER:locked} {$EDGE_AUTH_LIFTMAP_DASH_HASH:$2a$14$9MZGjXmdE909qdYVvzqwA.uVEz2MgWIioYtPnUFe3A932J8L0ObL2}
	}
	request_header @dash -Authorization
	reverse_proxy liftmap-api:8080
}
